---
// Inclure dans le <head> de chaque page.
// GA ne se charge qu'après consentement (localStorage 'lcp-consent' === 'accepted').
// Le cookie banner doit aussi appeler loadGA() au clic "Accepter".
---
<script>
  (function() {
    const GA_ID = 'G-PK9JHLK9YF';
    const consent = localStorage.getItem('lcp-consent');
    if (consent === 'refused') { window['ga-disable-' + GA_ID] = true; return; }
    if (consent === 'accepted') {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID);
    }
  })();
</script>
