    </div>
  </div>
</div>

<script>
  // Season tabs
  document.querySelectorAll('.season-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      const season = this.dataset.season;
      document.querySelectorAll('.season-tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      document.querySelectorAll('.season-panel').forEach(p => p.classList.add('hidden'));
      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');
      document.querySelector('[data-panel="' + season + '"]').classList.remove('hidden');
    });
  });

  // Dropdown nav
  document.querySelectorAll('.nav-item-drop').forEach(function(d) {
    d.querySelector('.nav-drop-toggle').addEventListener('click', function(e) {
      if (window.innerWidth <= 680) { e.preventDefault(); d.classList.toggle('open'); }
    });
  });

  // Burger menu
  const burger = document.getElementById('navBurger');
  const navLinks = document.getElementById('navLinks');
  burger?.addEventListener('click', () => {
    burger.classList.toggle('open');
    navLinks?.classList.toggle('open');
  });

  // Vinyl ring scroll animation + image rotation
  const vinylStage = document.getElementById('vinylStage');
  if (vinylStage) {
    const rings = vinylStage.querySelectorAll('.vinyl-ring');
    const vinylImg = vinylStage.querySelector('.vinyl-image');
    window.addEventListener('scroll', function() {
      const scrollY = window.scrollY;
      const heroH = document.getElementById('hero').offsetHeight;
      const progress = Math.min(scrollY / (heroH * 0.8), 1);
      const scale = 1 + progress * 0.45;
      const rotateDeg = scrollY * 0.12;
      rings.forEach(function(r) {
        r.style.setProperty('--ring-scale', scale);
      });
      if (vinylImg) {
        vinylImg.style.setProperty('--vinyl-rotate', rotateDeg + 'deg');
      }
    }, { passive: true });
  }

  // Host photos rotation on scroll — relative to section entry
  const hostPhotos = document.querySelectorAll('.host-photo--rotate');
  if (hostPhotos.length) {
    const hostsSection = document.querySelector('.hosts-section');
    window.addEventListener('scroll', function() {
      const sectionTop = hostsSection ? hostsSection.getBoundingClientRect().top + window.scrollY : 0;
      const relativeScroll = Math.max(0, window.scrollY - sectionTop + window.innerHeight * 0.5);
      const deg = relativeScroll * 0.08;
      hostPhotos.forEach(function(p, i) {
        p.style.setProperty('--host-rotate', (i % 2 === 0 ? deg : -deg) + 'deg');
      });
    }, { passive: true });
  }

  // SEO visual rotation on scroll — relative to section entry
  const seoImg = document.querySelector('.seo-img');
  if (seoImg) {
    const seoSection = document.querySelector('.seo-block');
    window.addEventListener('scroll', function() {
      const sectionTop = seoSection ? seoSection.getBoundingClientRect().top + window.scrollY : 0;
      const rel = Math.max(0, window.scrollY - sectionTop + window.innerHeight * 0.5);
      seoImg.style.setProperty('--seo-rotate', (rel * 0.06) + 'deg');
    }, { passive: true });
  }

  // Back to top
  const backTop = document.getElementById('backTop');
  window.addEventListener('scroll', function() {
    backTop?.classList.toggle('visible', window.scrollY > 400);
  }, { passive: true });
  backTop?.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Footer year
  document.getElementById('footerYear').textContent = new Date().getFullYear().toString();

  // Cookie banner
  (function(){
    const KEY = 'lcp-consent';
    const banner = document.getElementById('cookieBanner');
    if (!localStorage.getItem(KEY)) banner.classList.add('cookie-visible');
    function hide() { banner.classList.add('cookie-hide'); setTimeout(() => banner.remove(), 400); }
    document.getElementById('cookieAccept')?.addEventListener('click', () => { localStorage.setItem(KEY, 'accepted'); hide(); });
    document.getElementById('cookieRefuse')?.addEventListener('click', () => { localStorage.setItem(KEY, 'refused'); hide(); });
  })();
</script>

