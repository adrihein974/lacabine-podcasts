  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --blue: #001ed1; --blue-dark: #0016a8; --white: #fff; }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--blue);
      color: var(--white);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* NAV */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0 24px;
      background: rgba(0, 20, 180, 0.88);
      backdrop-filter: blur(14px);
      border-bottom: 0.5px solid rgba(255,255,255,0.1);
      height: 64px;
      display: flex; align-items: center;
    }
    .nav-inner { max-width: 1200px; margin: 0 auto; width: 100%; display: flex; align-items: center; gap: 32px; }
    .nav-logo img { display: block; height: 40px; width: auto; filter: brightness(0) invert(1); }
    .nav-links { display: flex; align-items: center; gap: 24px; list-style: none; margin-left: auto; }
    .nav-links a { font-size: 0.95rem; font-weight: 500; color: rgba(255,255,255,0.85); text-decoration: none; transition: color .2s; }
    .nav-links a:hover, .nav-links a[aria-current] { color: #fff; }
    .nav-cta {
      margin-left: 8px;
      background: #fff; color: var(--blue);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 0.85rem; letter-spacing: .02em;
      padding: 10px 20px; border-radius: 50px;
      text-decoration: none; white-space: nowrap;
      transition: background .2s, color .2s;
    }
    .nav-cta:hover { background: rgba(255,255,255,0.88); }
    .nav-burger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px; margin-left: auto;
    }
    .nav-burger span { display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px; transition: .3s; }
    .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger.open span:nth-child(2) { opacity: 0; }
    .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* DROPDOWN */
    .nav-item-drop { position: relative; }
    .nav-drop-toggle { display: inline-flex; align-items: center; gap: 4px; }
    .nav-caret { font-size: 9px; display: inline-block; transition: transform .2s; }
    .nav-item-drop:hover .nav-caret { transform: rotate(180deg); }
    .nav-drop-menu {
      display: none; position: absolute; top: calc(100% + 12px); left: 50%;
      transform: translateX(-50%);
      background: rgba(0,10,100,0.97); backdrop-filter: blur(10px);
      border: 0.5px solid rgba(255,255,255,0.15); border-radius: 10px;
      min-width: 220px; padding: 5px; list-style: none; z-index: 200;
    }
    .nav-item-drop:hover .nav-drop-menu,
    .nav-item-drop.open .nav-drop-menu { display: block; }
    .nav-drop-menu li a {
      display: block; padding: 9px 12px; border-radius: 6px;
      font-size: 13px; color: rgba(255,255,255,0.75);
      transition: background .15s, color .15s;
    }
    .nav-drop-menu li a:hover { background: rgba(255,255,255,0.1); color: #fff; }

    @media (max-width: 680px) {
      .nav-links { display: none; flex-direction: column; gap: 12px; position: fixed; top: 64px; left: 0; right: 0; background: rgba(0,15,160,0.97); padding: 24px; }
      .nav-links.open { display: flex; }
      .nav-burger { display: flex; }
      .nav-cta { display: none; }
      .nav-drop-menu { position: static; transform: none; background: rgba(255,255,255,0.08); border: none; border-radius: 8px; min-width: unset; margin-top: 6px; display: none; }
      .nav-item-drop.open .nav-drop-menu { display: block; }
    }

    /* HERO */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex; align-items: center;
      overflow: hidden;
      padding-top: 64px;
    }

    /* VINYL RINGS */
    .vinyl-stage {
      position: absolute;
      top: 50%; right: -10vw;
      transform: translateY(-50%);
      width: 700px; height: 700px;
      pointer-events: none;
    }
    .vinyl-ring {
      position: absolute;
      top: 50%; left: 50%;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.12);
      transform: translate(-50%, -50%) scale(var(--ring-scale, 1));
      transition: transform 0.05s linear;
    }
    .vinyl-ring:nth-child(1) { width: 200px; height: 200px; border-color: rgba(255,255,255,0.4); border-width: 2px; }
    .vinyl-ring:nth-child(2) { width: 300px; height: 300px; border-color: rgba(255,255,255,0.22); }
    .vinyl-ring:nth-child(3) { width: 420px; height: 420px; border-color: rgba(255,255,255,0.16); }
    .vinyl-ring:nth-child(4) { width: 560px; height: 560px; border-color: rgba(255,255,255,0.11); }
    .vinyl-ring:nth-child(5) { width: 700px; height: 700px; border-color: rgba(255,255,255,0.07); }
    .vinyl-ring:nth-child(6) { width: 900px; height: 900px; border-color: rgba(255,255,255,0.05); }
    .vinyl-ring:nth-child(7) { width: 1100px; height: 1100px; border-color: rgba(255,255,255,0.03); }
    .vinyl-ring:nth-child(8) { width: 1400px; height: 1400px; border-color: rgba(255,255,255,0.02); }

    .vinyl-image {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 160px; height: 160px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.3);
      box-shadow: 0 0 40px rgba(0,0,0,0.4);
    }

    /* HERO CONTENT */
    .hero-content {
      position: relative; z-index: 2;
      max-width: 620px;
      padding: 80px 48px 80px 8vw;
    }
    .hero-eyebrow {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-bottom: 20px;
    }
    .hero-display-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(48px, 8.5vw, 92px);
      font-weight: 800;
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 32px;
    }
    .hero-description {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.65;
      color: rgba(255,255,255,0.72);
      max-width: 480px;
      margin-bottom: 40px;
    }
    .hero-cta {
      display: inline-flex; align-items: center; gap: 10px;
      background: #fff; color: var(--blue);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 1rem; letter-spacing: 0.01em;
      padding: 16px 32px; border-radius: 50px;
      text-decoration: none;
      transition: background .2s, transform .2s;
      box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    }
    .hero-cta:hover { background: rgba(255,255,255,0.9); transform: translateY(-2px); }
    .hero-cta-arrow { font-size: 1.1rem; }

    /* EPISODES SECTION PLACEHOLDER */
    #section-episodes {
      min-height: 80px;
      background: var(--blue-dark);
    }

    /* FOOTER */
    .footer {
      background: rgba(0,0,0,0.25);
      padding: 60px 24px 32px;
      border-top: 0.5px solid rgba(255,255,255,0.1);
    }
    .footer-inner { max-width: 1200px; margin: 0 auto; }
    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      gap: 48px;
      margin-bottom: 48px;
    }
    .footer-brand p, .footer-brand address { font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-top: 12px; font-style: normal; line-height: 1.6; }
    .footer-brand a { color: rgba(255,255,255,0.5); text-decoration: none; display: block; margin-top: 4px; }
    .footer-brand a:hover { color: #fff; }
    .footer-brand img { filter: brightness(0) invert(1); opacity: 0.8; }
    .footer nav h4 { font-family: 'Hanken Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 16px; }
    .footer nav ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer nav ul li a { font-size: 0.875rem; color: rgba(255,255,255,0.6); text-decoration: none; transition: color .2s; }
    .footer nav ul li a:hover { color: #fff; }
    .footer-bottom { border-top: 0.5px solid rgba(255,255,255,0.1); padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .footer-copy { font-size: 0.8rem; color: rgba(255,255,255,0.35); }
    .footer-legal { display: flex; gap: 20px; }
    .footer-legal a { font-size: 0.8rem; color: rgba(255,255,255,0.35); text-decoration: none; }
    .footer-legal a:hover { color: rgba(255,255,255,0.7); }

    /* COOKIE BANNER */
    .cookie-banner {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      width: min(560px, calc(100vw - 32px));
      background: rgba(10,10,10,0.97); border: 0.5px solid rgba(255,255,255,0.15);
      border-radius: 16px; padding: 20px 24px;
      z-index: 9999; display: none; box-shadow: 0 8px 40px rgba(0,0,0,0.4);
    }
    .cookie-banner.cookie-visible { display: block; }
    .cookie-banner.cookie-hide { animation: fadeOut .4s forwards; }
    @keyframes fadeOut { to { opacity: 0; transform: translateX(-50%) translateY(20px); } }
    .cookie-text { font-size: 0.85rem; color: rgba(255,255,255,0.75); line-height: 1.5; margin-bottom: 14px; }
    .cookie-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .cookie-link { font-size: 0.8rem; color: rgba(255,255,255,0.45); text-decoration: underline; margin-right: auto; }
    .cookie-btn { padding: 8px 18px; border-radius: 50px; font-family: 'Hanken Grotesk', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; border: none; transition: opacity .2s; }
    .cookie-refuse { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); }
    .cookie-accept { background: #fff; color: #000; }
    .cookie-btn:hover { opacity: 0.85; }

    /* BACK TO TOP */
    .back-top {
      position: fixed; bottom: 28px; right: 24px; z-index: 90;
      width: 42px; height: 42px; border-radius: 50%;
      background: rgba(255,255,255,0.15); border: 0.5px solid rgba(255,255,255,0.2);
      color: #fff; font-size: 18px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .3s, background .2s;
    }
    .back-top.visible { opacity: 1; pointer-events: auto; }
    .back-top:hover { background: rgba(255,255,255,0.25); }

    @media (max-width: 900px) {
      .vinyl-stage { right: -20vw; width: 500px; height: 500px; opacity: 0.5; }
      .hero-content { padding: 60px 24px 60px 24px; }
      .footer-top { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 540px) {
      .vinyl-stage { display: none; }
      .hero-content { padding: 48px 24px; }
      .footer-top { grid-template-columns: 1fr; gap: 32px; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
