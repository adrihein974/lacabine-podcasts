  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --blue: #001ed1; --blue-dark: #0016a8; --white: #fff; }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--blue);
      color: var(--white);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* NAV — identique homepage */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(23, 74, 150, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto;
      padding: 0 1.5rem; height: 70px;
      display: flex; align-items: center; gap: 2rem;
    }
    .nav-logo img { display: block; height: 56px; width: auto; }
    .nav-links { display: flex; align-items: center; gap: 1.75rem; list-style: none; margin-left: auto; }
    .nav-links a { font-size: 0.9rem; font-weight: 500; color: #fff; text-decoration: none; opacity: 0.8; transition: opacity .15s; }
    .nav-links a:hover, .nav-links a[aria-current] { opacity: 1; }
    .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 50px; font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 0.95rem; cursor: pointer; transition: transform 0.15s, opacity 0.15s; white-space: nowrap; text-decoration: none; }
    .btn:hover { transform: translateY(-2px); opacity: 0.92; }
    .btn-white { background: #fff; color: #174A96; }
    .nav-cta { margin-left: 1rem; }
    .nav-burger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 4px; margin-left: auto;
    }
    .nav-burger span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: all 0.2s; }
    .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger.open span:nth-child(2) { opacity: 0; }
    .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* DROPDOWN */
    .nav-item-drop { position: relative; }
    .nav-drop-toggle { display: inline-flex; align-items: center; gap: 4px; }
    .nav-caret { font-size: 9px; display: inline-block; transition: transform .2s; }
    .nav-item-drop:hover .nav-caret { transform: rotate(180deg); }
    .nav-drop-menu {
      display: none; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      background: rgba(8,8,8,0.96); backdrop-filter: blur(10px);
      border: 0.5px solid rgba(255,255,255,0.12); border-radius: 10px;
      min-width: 220px; padding: 12px 5px 5px; list-style: none; z-index: 200;
    }
    .nav-item-drop:hover .nav-drop-menu,
    .nav-item-drop.open .nav-drop-menu { display: block; }
    .nav-drop-menu li a {
      display: block; padding: 9px 12px; border-radius: 6px;
      font-size: 13px; color: rgba(255,255,255,0.75); opacity: 1 !important;
      transition: background .15s, color .15s;
    }
    .nav-drop-menu li a:hover { background: rgba(255,255,255,0.08); color: #fff; }

    @media (max-width: 540px) {
      .nav-links { display: none; flex-direction: column; gap: 1rem; position: absolute; top: 70px; left: 0; right: 0; background: #174A96; padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .nav-links.open { display: flex; }
      .nav-burger { display: flex; }
      .nav-cta { display: none; }
      .nav-drop-menu { position: static; transform: none; background: rgba(0,0,0,0.2); border: none; border-radius: 8px; min-width: unset; margin-top: 5px; display: none; }
      .nav-item-drop.open .nav-drop-menu { display: block; }
    }

    /* HERO */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex; align-items: center;
      overflow: hidden;
      padding-top: 0;
    }

    /* VINYL RINGS */
    .vinyl-stage {
      position: absolute;
      top: 50%; right: -10vw;
      transform: translateY(-50%);
      width: 700px; height: 700px;
      pointer-events: none;
    }
    .vinyl-ring {
      position: absolute;
      top: 50%; left: 50%;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.12);
      transform: translate(-50%, -50%) scale(var(--ring-scale, 1));
      transition: transform 0.05s linear;
    }
    .vinyl-ring:nth-child(1) { width: 200px; height: 200px; border-color: rgba(255,255,255,0.4); border-width: 2px; }
    .vinyl-ring:nth-child(2) { width: 300px; height: 300px; border-color: rgba(255,255,255,0.22); }
    .vinyl-ring:nth-child(3) { width: 420px; height: 420px; border-color: rgba(255,255,255,0.16); }
    .vinyl-ring:nth-child(4) { width: 560px; height: 560px; border-color: rgba(255,255,255,0.11); }
    .vinyl-ring:nth-child(5) { width: 700px; height: 700px; border-color: rgba(255,255,255,0.07); }
    .vinyl-ring:nth-child(6) { width: 900px; height: 900px; border-color: rgba(255,255,255,0.05); }
    .vinyl-ring:nth-child(7) { width: 1100px; height: 1100px; border-color: rgba(255,255,255,0.03); }
    .vinyl-ring:nth-child(8) { width: 1400px; height: 1400px; border-color: rgba(255,255,255,0.02); }

    .vinyl-image {
      border-radius: 50%;
      object-fit: cover;
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%) rotate(var(--vinyl-rotate, 0deg));
      width: 416px; height: 416px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.3);
      box-shadow: 0 0 60px rgba(0,0,0,0.5);
      will-change: transform;
    }

    /* HERO CONTENT */
    .hero-content {
      position: relative; z-index: 2;
      max-width: 620px;
      padding: 80px 48px 80px 8vw;
    }
    .hero-eyebrow {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-bottom: 20px;
    }
    .hero-display-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(48px, 8.5vw, 92px);
      font-weight: 800;
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 32px;
    }
    .hero-description {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.65;
      color: rgba(255,255,255,0.72);
      max-width: 480px;
      margin-bottom: 40px;
    }
    .hero-cta {
      display: inline-flex; align-items: center; gap: 10px;
      background: #fff; color: var(--blue);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 1rem; letter-spacing: 0.01em;
      padding: 16px 32px; border-radius: 50px;
      text-decoration: none;
      transition: background .2s, transform .2s;
      box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    }
    .hero-cta:hover { background: rgba(255,255,255,0.9); transform: translateY(-2px); }
    .hero-cta-arrow { font-size: 1.1rem; }

    /* EPISODES SECTION PLACEHOLDER */
    #section-episodes {
      min-height: 80px;
      background: var(--blue-dark);
    }

    /* EPISODES SECTION */
    .episodes-section {
      background: #000fa8;
      padding: 100px 0 120px;
    }
    .ep-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
    }
    .ep-header {
      margin-bottom: 64px;
    }
    .ep-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 12px;
    }
    .ep-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(40px, 6vw, 72px);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #fff;
      margin-bottom: 36px;
    }
    .season-tabs {
      display: flex;
      gap: 10px;
    }
    .season-tab {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 0.85rem; font-weight: 700;
      letter-spacing: 0.04em;
      padding: 10px 24px;
      border-radius: 50px;
      border: 1.5px solid rgba(255,255,255,0.25);
      background: transparent;
      color: rgba(255,255,255,0.55);
      cursor: pointer;
      transition: all .2s;
    }
    .season-tab:hover { border-color: rgba(255,255,255,0.6); color: #fff; }
    .season-tab.active {
      background: #fff;
      border-color: #fff;
      color: #000fa8;
    }

    .season-panel { display: block; }
    .season-panel.hidden { display: none; }

    .ep-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
    .ep-card {
      background: rgba(255,255,255,0.06);
      border: 0.5px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      overflow: hidden;
      transition: transform .25s, background .25s;
    }
    .ep-card:hover {
      transform: translateY(-4px);
      background: rgba(255,255,255,0.1);
    }
    .ep-thumb-link { display: block; }
    .ep-thumb {
      position: relative;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: rgba(0,0,0,0.3);
    }
    .ep-thumb img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .4s;
    }
    .ep-card:hover .ep-thumb img { transform: scale(1.04); }
    .ep-play {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; color: #fff;
      background: rgba(0,0,0,0.3);
      opacity: 0;
      transition: opacity .2s;
    }
    .ep-card:hover .ep-play { opacity: 1; }
    .ep-body {
      padding: 20px 22px 22px;
    }
    .ep-badge {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 10px;
    }
    .ep-guest {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 1.1rem; font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
      line-height: 1.2;
    }
    .ep-headline {
      font-size: 0.9rem; font-weight: 400;
      color: rgba(255,255,255,0.7);
      line-height: 1.45;
      margin-bottom: 6px;
    }
    .ep-sub {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.38);
      margin-bottom: 18px;
    }
    .ep-ctas {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .ep-btn {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.03em;
      padding: 8px 14px; border-radius: 50px;
      text-decoration: none;
      transition: opacity .15s, transform .15s;
    }
    .ep-btn:hover { opacity: 0.82; transform: translateY(-1px); }
    .ep-btn-yt { background: #FF0000; color: #fff; }
    .ep-btn-sp { background: #1DB954; color: #fff; }

    @media (max-width: 900px) {
      .ep-grid { grid-template-columns: repeat(2, 1fr); }
      .ep-container { padding: 0 24px; }
    }
    @media (max-width: 560px) {
      .ep-grid { grid-template-columns: 1fr; }
      .episodes-section { padding: 64px 0 80px; }
    }

    /* HOSTS */
    .hosts-section {
      background: var(--blue);
      padding: 100px 0 110px;
    }
    .hosts-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
    }
    .hosts-header {
      margin-bottom: 64px;
    }
    .hosts-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 12px;
    }
    .hosts-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(36px, 5vw, 64px);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 8px;
    }
    .hosts-names {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(18px, 2.5vw, 28px);
      font-weight: 700;
      color: rgba(255,255,255,0.5);
    }
    .hosts-layout {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 72px;
    }
    .hosts-photos {
      display: flex;
      gap: -32px;
      position: relative;
    }
    .host-orbit {
      position: relative;
      width: 240px;
      height: 240px;
      flex-shrink: 0;
    }
    .host-orbit + .host-orbit {
      margin-left: -48px;
    }
    .host-ring {
      position: absolute;
      top: 50%; left: 50%;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.15);
      transform: translate(-50%, -50%) scale(var(--ring-scale, 1));
      pointer-events: none;
    }
    .host-ring--1 { width: 280px; height: 280px; border-color: rgba(255,255,255,0.18); }
    .host-ring--2 { width: 340px; height: 340px; border-color: rgba(255,255,255,0.10); }
    .host-ring--3 { width: 410px; height: 410px; border-color: rgba(255,255,255,0.05); }
    .host-photo {
      position: absolute;
      top: 0; left: 0;
      width: 240px; height: 240px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center center;
      border: 3px solid rgba(255,255,255,0.25);
      box-shadow: 0 0 40px rgba(0,0,0,0.35);
      transform: rotate(var(--host-rotate, 0deg));
      will-change: transform;
    }
    .hosts-text {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .hosts-desc {
      font-size: clamp(1rem, 1.5vw, 1.1rem);
      line-height: 1.7;
      color: rgba(255,255,255,0.68);
      max-width: 540px;
    }

    /* NEWSLETTER */
    .newsletter-section {
      background: rgba(255,255,255,0.06);
      border-top: 0.5px solid rgba(255,255,255,0.1);
      border-bottom: 0.5px solid rgba(255,255,255,0.1);
      padding: 80px 0;
    }
    .nl-container {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 48px;
      text-align: center;
    }
    .nl-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 16px;
    }
    .nl-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
      margin-bottom: 16px;
    }
    .nl-sub {
      font-size: 1rem;
      color: rgba(255,255,255,0.6);
      line-height: 1.6;
      margin-bottom: 36px;
    }
    .nl-cta {
      display: inline-flex; align-items: center; gap: 10px;
      background: #fff; color: var(--blue);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 1rem;
      padding: 16px 36px; border-radius: 50px;
      text-decoration: none;
      transition: background .2s, transform .2s;
      box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    }
    .nl-cta:hover { background: rgba(255,255,255,0.88); transform: translateY(-2px); }

    /* SEO BLOCK */
    .seo-block {
      background: rgba(0,0,0,0.15);
      padding: 80px 0;
      border-top: 0.5px solid rgba(255,255,255,0.07);
    }
    .seo-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4rem;
      align-items: center;
    }
    .seo-text { max-width: 640px; }
    .seo-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 1.55rem; font-weight: 800;
      color: rgba(255,255,255,0.75);
      margin-bottom: 24px;
      letter-spacing: -0.01em;
