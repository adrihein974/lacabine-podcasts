<script>
  // Dropdown nav
  document.querySelectorAll('.nav-item-drop').forEach(function(d) {
    d.querySelector('.nav-drop-toggle').addEventListener('click', function(e) {
      if (window.innerWidth <= 680) { e.preventDefault(); d.classList.toggle('open'); }
    });
  });

  // Burger menu
  const burger = document.getElementById('navBurger');
  const navLinks = document.getElementById('navLinks');
  burger?.addEventListener('click', () => {
    burger.classList.toggle('open');
    navLinks?.classList.toggle('open');
  });

  // Vinyl ring scroll animation
  const vinylStage = document.getElementById('vinylStage');
  if (vinylStage) {
    const rings = vinylStage.querySelectorAll('.vinyl-ring');
    window.addEventListener('scroll', function() {
      const scrollY = window.scrollY;
      const heroH = document.getElementById('hero').offsetHeight;
      const progress = Math.min(scrollY / (heroH * 0.8), 1);
      const scale = 1 + progress * 0.45;
      rings.forEach(function(r) {
        r.style.setProperty('--ring-scale', scale);
      });
    }, { passive: true });
  }

  // Back to top
  const backTop = document.getElementById('backTop');
  window.addEventListener('scroll', function() {
    backTop?.classList.toggle('visible', window.scrollY > 400);
  }, { passive: true });
  backTop?.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Footer year
  document.getElementById('footerYear').textContent = new Date().getFullYear().toString();

  // Cookie banner
  (function(){
    const KEY = 'lcp-consent';
    const banner = document.getElementById('cookieBanner');
    if (!localStorage.getItem(KEY)) banner.classList.add('cookie-visible');
    function hide() { banner.classList.add('cookie-hide'); setTimeout(() => banner.remove(), 400); }
    document.getElementById('cookieAccept')?.addEventListener('click', () => { localStorage.setItem(KEY, 'accepted'); hide(); });
    document.getElementById('cookieRefuse')?.addEventListener('click', () => { localStorage.setItem(KEY, 'refused'); hide(); });
  })();
</script>

</body>
</html>
