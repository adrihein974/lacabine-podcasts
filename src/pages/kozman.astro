  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --mauve: #7B3FA0;
      --mauve-dark: #5C2D78;
      --rose: #C8409A;
      --rose-light: #E060B8;
      --white: #fff;
      --dark: #1a0a24;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--dark);
      color: var(--white);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── NAV ── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(44, 12, 70, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto;
      padding: 0 1.5rem; height: 70px;
      display: flex; align-items: center; gap: 2rem;
    }
    .nav-logo img { display: block; height: 56px; width: auto; }
    .nav-links { display: flex; align-items: center; gap: 1.75rem; list-style: none; margin-left: auto; }
    .nav-links a { font-size: 0.9rem; font-weight: 500; color: #fff; text-decoration: none; opacity: 0.8; transition: opacity .15s; }
    .nav-links a:hover, .nav-links a[aria-current] { opacity: 1; }
    .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 50px; font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 0.95rem; cursor: pointer; transition: transform 0.15s, opacity 0.15s; white-space: nowrap; text-decoration: none; }
    .btn:hover { transform: translateY(-2px); opacity: 0.92; }
    .btn-white { background: #fff; color: var(--mauve-dark); }
    .nav-cta { margin-left: 1rem; }
    .nav-cta-mobile { display: none; }
    .btn-lime { background: #C8F03A; color: #111827; font-weight: 700; border-radius: 10px; padding: 0.65rem 1.5rem; text-decoration: none; display: inline-block; }
    .nav-burger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 4px; margin-left: auto;
    }
    .nav-burger span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: all 0.2s; }
    .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger.open span:nth-child(2) { opacity: 0; }
    .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-item-drop { position: relative; }
    .nav-drop-toggle { display: inline-flex; align-items: center; gap: 4px; }
    .nav-caret { font-size: 9px; display: inline-block; transition: transform .2s; }
    .nav-item-drop:hover .nav-caret { transform: rotate(180deg); }
    .nav-drop-menu {
      display: none; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      background: rgba(8,8,8,0.96); backdrop-filter: blur(10px);
      border: 0.5px solid rgba(255,255,255,0.12); border-radius: 10px;
      min-width: 220px; padding: 12px 5px 5px; list-style: none; z-index: 200;
    }
    .nav-item-drop:hover .nav-drop-menu,
    .nav-item-drop.open .nav-drop-menu { display: block; }
    .nav-drop-menu li a {
      display: block; padding: 9px 12px; border-radius: 6px;
      font-size: 13px; color: rgba(255,255,255,0.75); opacity: 1 !important;
      transition: background .15s, color .15s;
    }
    .nav-drop-menu li a:hover { background: rgba(255,255,255,0.08); color: #fff; }

    @media (max-width: 768px) {
      .nav-links { display: none; flex-direction: column; gap: 1rem; position: absolute; top: 70px; left: 0; right: 0; background: #2c0c46; padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .nav-links.open { display: flex; }
      .nav-burger { display: flex; }
      .nav-cta { display: none; }
      .nav-cta-mobile { display: list-item; }
      .nav-drop-menu { position: static; transform: none; background: rgba(0,0,0,0.2); border: none; border-radius: 8px; min-width: unset; margin-top: 5px; display: none; }
      .nav-item-drop.open .nav-drop-menu { display: block; }
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      background: #2a0a40;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background-image: url('/images/kozman-background.png');
      background-size: cover;
      background-position: center;
      opacity: 0.75;
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(20,5,35,0.3) 0%, rgba(20,5,35,0.15) 50%, rgba(20,5,35,0.7) 100%);
    }
    .hero-content {
      position: relative; z-index: 2;
      max-width: 800px;
      text-align: center;
      padding: 80px 24px;
      display: flex; flex-direction: column; align-items: center;
    }
    .hero-logo-img {
      width: clamp(240px, 55vw, 480px);
      height: auto;
      display: block;
      margin-bottom: 40px;
      filter: brightness(0) invert(1);
    }
    .hero-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.5);
      margin-bottom: 20px;
    }
    .hero-description {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.7;
      color: rgba(255,255,255,0.82);
      max-width: 600px;
      margin-bottom: 16px;
    }
    .hero-tags {
      display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
      margin-bottom: 44px;
    }
    .hero-tag {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50px;
      padding: 6px 16px;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.8);
    }
    .hero-cta {
      display: inline-flex; align-items: center; gap: 10px;
      background: #fff; color: var(--mauve-dark);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 1rem; letter-spacing: 0.01em;
      padding: 16px 36px; border-radius: 50px;
      text-decoration: none;
      transition: background .2s, transform .2s;
      box-shadow: 0 4px 32px rgba(0,0,0,0.3);
    }
    .hero-cta:hover { background: rgba(255,255,255,0.92); transform: translateY(-2px); }

    /* ── EPISODES ── */
    .episodes-section {
      padding: 100px 0 120px;
      background: var(--dark);
    }
    .ep-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .ep-header { margin-bottom: 64px; text-align: center; }
    .ep-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 12px;
    }
    .ep-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      color: #fff;
      line-height: 1.1;
    }

    .ep-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(460px, 1fr));
      gap: 32px;
    }
    @media (max-width: 560px) {
      .ep-grid { grid-template-columns: 1fr; }
    }

    .ep-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      overflow: hidden;
      transition: transform .2s, border-color .2s;
    }
    .ep-card:hover { transform: translateY(-4px); border-color: rgba(200,64,154,0.3); }

    .ep-thumb-link { display: block; position: relative; }
    .ep-thumb {
      position: relative;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: #1a0a24;
    }
    .ep-thumb img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .3s;
    }
    .ep-card:hover .ep-thumb img { transform: scale(1.04); }
    .ep-play {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 56px; height: 56px;
      background: rgba(200,64,154,0.88);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      color: #fff;
      backdrop-filter: blur(4px);
      transition: background .2s, transform .2s;
    }
    .ep-card:hover .ep-play { background: var(--rose); transform: translate(-50%, -50%) scale(1.1); }

    .ep-body { padding: 24px; }
    .ep-num {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--rose-light);
      margin-bottom: 10px;
    }
    .ep-headline {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(16px, 1.5vw, 19px);
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
      margin-bottom: 10px;
    }
    .ep-sub {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.55);
      line-height: 1.55;
      margin-bottom: 20px;
    }
    .ep-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
    .ep-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 18px; border-radius: 50px;
      font-size: 0.82rem; font-weight: 600;
      text-decoration: none;
      transition: opacity .15s, transform .15s;
    }
    .ep-btn:hover { opacity: 0.85; transform: translateY(-1px); }
    .ep-btn-yt { background: #FF0000; color: #fff; }
    .ep-btn-sp { background: #1DB954; color: #fff; }

    /* ── HOSTS ── */
    .hosts-section {
      background: linear-gradient(135deg, #2c0a45 0%, #1a0530 50%, #2a0840 100%);
      padding: 100px 0 120px;
    }
    .hosts-container {
      max-width: 1100px; margin: 0 auto; padding: 0 24px;
    }
    .hosts-header { text-align: center; margin-bottom: 64px; }
    .hosts-eyebrow {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 12px;
    }
    .hosts-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      color: #fff;
      margin-bottom: 10px;
    }
    .hosts-names {
      font-size: 1rem;
      color: rgba(255,255,255,0.55);
    }

    .hosts-layout {
      display: flex;
      gap: 64px;
      align-items: center;
      flex-wrap: wrap;
    }
    .hosts-photos {
      display: flex;
      gap: 32px;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: center;
    }
    .host-orbit {
      position: relative;
      width: 220px; height: 220px;
    }
    .host-ring {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      border: 1px solid rgba(200,64,154,0.2);
    }
    .host-ring--1 { width: 100%; height: 100%; }
    .host-ring--2 { width: 118%; height: 118%; border-color: rgba(200,64,154,0.12); }
    .host-ring--3 { width: 138%; height: 138%; border-color: rgba(200,64,154,0.07); }
    .host-photo {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%) rotate(var(--host-rotate, 0deg));
      width: 200px; height: 200px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(200,64,154,0.4);
      box-shadow: 0 8px 40px rgba(0,0,0,0.4);
      will-change: transform;
    }

    .hosts-text { flex: 1; min-width: 280px; }
    .hosts-desc {
      font-size: 1rem;
      color: rgba(255,255,255,0.7);
      line-height: 1.7;
      margin-bottom: 16px;
    }
    .hosts-desc:last-child { margin-bottom: 0; }

    @media (max-width: 768px) {
      .hosts-layout { flex-direction: column; gap: 48px; }
      .hosts-photos { gap: 24px; }
      .host-orbit { width: 160px; height: 160px; }
      .host-photo { width: 144px; height: 144px; }
    }

    /* ── NEWSLETTER ── */
    .newsletter-section {
      background: linear-gradient(135deg, var(--rose) 0%, var(--mauve) 100%);
      padding: 80px 24px;
      text-align: center;
    }
    .nl-container { max-width: 600px; margin: 0 auto; }
    .nl-eyebrow {
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.65);
      margin-bottom: 16px;
    }
    .nl-title {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(26px, 4vw, 40px);
      font-weight: 800;
      color: #fff;
      line-height: 1.15;
      margin-bottom: 16px;
    }
    .nl-sub {
      font-size: 1rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.65;
      margin-bottom: 36px;
    }
    .nl-cta {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; color: var(--mauve-dark);
      font-family: 'Hanken Grotesk', sans-serif; font-weight: 700;
      font-size: 1rem;
      padding: 16px 36px; border-radius: 50px;
      text-decoration: none;
      transition: background .2s, transform .2s;
      box-shadow: 0 4px 24px rgba(0,0,0,0.25);
    }
    .nl-cta:hover { background: rgba(255,255,255,0.92); transform: translateY(-2px); }

    /* ── FOOTER ── */
    .footer {
      background: #0c0014;
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 64px 0 32px;
      color: rgba(255,255,255,0.65);
      font-size: 0.875rem;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1.5fr 1fr 1fr;
      gap: 48px;
      margin-bottom: 48px;
    }
    .footer-brand img { width: 140px; height: auto; display: block; }
    .footer-brand p, .footer-brand address { margin-top: 12px; font-style: normal; line-height: 1.6; }
    .footer-brand a { color: rgba(255,255,255,0.65); text-decoration: none; }
    .footer-brand a:hover { color: #fff; }
    .footer-nav h4, .footer-solutions h4, .footer-legal h4, .footer-social h4 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 0.8rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 16px;
    }
    .footer-nav ul, .footer-solutions ul, .footer-legal ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-nav a, .footer-solutions a, .footer-legal a { color: rgba(255,255,255,0.65); text-decoration: none; transition: color .15s; }
    .footer-nav a:hover, .footer-solutions a:hover, .footer-legal a:hover { color: #fff; }
    .social-links { display: flex; gap: 14px; flex-wrap: wrap; }
    .social-links a { color: rgba(255,255,255,0.55); transition: color .15s; }
    .social-links a:hover { color: #fff; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.07); padding-top: 24px; text-align: center; }
    .footer-bottom a { color: inherit; text-decoration: none; }
    .footer-bottom a:hover { color: #fff; }
    @media (max-width: 900px) {
      .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
      .footer-brand { grid-column: 1 / -1; }
    }
    @media (max-width: 540px) {
      .footer-top { grid-template-columns: 1fr; }
    }

    /* ── MISC ── */
    .back-top {
      position: fixed; bottom: 24px; right: 24px;
      width: 44px; height: 44px;
      background: rgba(200,64,154,0.85); color: #fff;
      border: none; border-radius: 50%; font-size: 18px;
      cursor: pointer; opacity: 0; pointer-events: none;
      transition: opacity .3s, transform .2s;
      z-index: 90;
    }
    .back-top.visible { opacity: 1; pointer-events: auto; }
    .back-top:hover { transform: translateY(-3px); }

    .cookie-banner {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: rgba(20,5,35,0.97);
      border-top: 1px solid rgba(255,255,255,0.1);
      padding: 16px 24px; z-index: 9999;
      display: none;
    }
    .cookie-banner.cookie-visible { display: block; }
    .cookie-banner.cookie-hide { animation: slideDown .4s forwards; }
    @keyframes slideDown { to { transform: translateY(100%); opacity: 0; } }
