---
const siteUrl = "https://lacabinepodcasts.com";
const pageUrl = `${siteUrl}/kozman/`;
const title = "KOZMAN, les récits intimes | Podcast La Cabine Podcasts";
const description = "Une série de podcasts immersifs qui donne la parole à celles et ceux qui osent partager un morceau de leur vie. Moments de bascule, secrets jamais révélés, héritages réunionnais.";
const ogTitle = "KOZMAN, les récits intimes : le podcast de La Cabine Podcasts";
const ogDescription = "Des histoires brutes, bouleversantes et profondément humaines. Une nouvelle production signée La Cabine Podcasts.";
