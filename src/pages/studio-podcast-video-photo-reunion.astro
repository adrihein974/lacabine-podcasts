  .footer-brand a:hover { opacity: 1; }
  .footer-nav h4, .footer-solutions h4, .footer-legal h4, .footer-social h4 {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.5; margin-bottom: 1.25rem;
  }
  .footer-nav ul, .footer-solutions ul, .footer-legal ul { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-nav a, .footer-solutions a, .footer-legal a { font-size: 0.88rem; opacity: 0.65; transition: opacity 0.15s; text-decoration: none; }
  .footer-nav a:hover, .footer-solutions a:hover, .footer-legal a:hover { opacity: 1; }
  .social-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .social-links a { opacity: 0.5; transition: opacity 0.15s; }
  .social-links a:hover { opacity: 1; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.82rem;
    opacity: 0.4;
  }
  .footer-bottom a { text-decoration: underline; text-underline-offset: 3px; opacity: 0.8; }

  /* COOKIE BANNER */
  .cookie-banner {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 999;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cookie-banner.cookie-visible { transform: translateY(0); }
  .cookie-banner.cookie-hide { transform: translateY(100%); }
  .cookie-inner {
    background: #0d1b3e;
    border-top: 1px solid rgba(255,255,255,0.12);
    padding: 1.1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
  }
  .cookie-text { font-size: 0.88rem; opacity: 0.85; flex: 1; min-width: 200px; line-height: 1.5; }
  .cookie-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; flex-shrink: 0; }
  .cookie-link { font-size: 0.82rem; opacity: 0.55; text-decoration: underline; text-underline-offset: 3px; transition: opacity 0.15s; }
  .cookie-link:hover { opacity: 0.9; }
  .cookie-btn {
    padding: 0.5rem 1.1rem; border-radius: 50px;
    font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 0.85rem;
    cursor: pointer; border: none; transition: transform 0.15s, opacity 0.15s;
  }
  .cookie-btn:hover { transform: translateY(-1px); opacity: 0.9; }
  .cookie-refuse { background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); }
  .cookie-accept { background: #fff; color: #174A96; }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .temoins-grid { grid-template-columns: repeat(2, 1fr); }
    .voir-aussi-grid { grid-template-columns: 1fr; }
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .nav-links { display: none; }
    .nav-links.open { display: flex; flex-direction: column; position: fixed; inset: 70px 0 0; background: #174A96; padding: 2rem 1.5rem; gap: 1.5rem; z-index: 99; }
    .nav-cta { display: none; }
    .nav-burger { display: flex; }
    .temoins-grid { grid-template-columns: 1fr; }
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
    .cta-final-article { padding: 1.75rem 1.25rem; }
  }
  .back-to-top { position: fixed; bottom: 2rem; right: 1.5rem; z-index: 90; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.65); font-size: 1.15rem; cursor: pointer; opacity: 0; transform: translateY(8px); transition: opacity 0.25s, transform 0.25s, background 0.2s; backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; }
  .back-to-top.visible { opacity: 1; transform: translateY(0); }
  .back-to-top:hover { background: rgba(255,255,255,0.2); color: #fff; }
  .read-progress {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    width: 0%;
    background: rgba(255,255,255,0.55);
    z-index: 200;
    transition: width 0.1s linear;
    pointer-events: none;
  }


  .nav-item-drop { position: relative; }
  .nav-drop-toggle { display: inline-flex; align-items: center; gap: 4px; }
  .nav-caret { font-size: 9px; display: inline-block; transition: transform .2s; }
  .nav-item-drop:hover .nav-caret { transform: rotate(180deg); }
  .nav-drop-menu { display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); background: rgba(8,8,8,0.96); backdrop-filter: blur(10px); border: 0.5px solid rgba(255,255,255,0.12); border-radius: 10px; min-width: 220px; padding: 12px 5px 5px; list-style: none; z-index: 200; }
  .nav-item-drop:hover .nav-drop-menu, .nav-item-drop.open .nav-drop-menu { display: block; }
  .nav-drop-menu li a { display: block; padding: 9px 12px; border-radius: 6px; font-size: 13px; color: rgba(255,255,255,0.75); opacity: 1 !important; transition: background .15s, color .15s; }
  .nav-drop-menu li a:hover { background: rgba(255,255,255,0.08); color: #fff; }
  @media (max-width: 540px) {
    .nav-drop-menu { position: static; transform: none; background: rgba(0,0,0,0.25); border: none; border-radius: 8px; min-width: unset; margin-top: 5px; display: none; }
    .nav-item-drop.open .nav-drop-menu { display: block; }
  }
</style>

<script>
  
  document.querySelectorAll('.nav-item-drop').forEach(function(d) {
    d.querySelector('.nav-drop-toggle').addEventListener('click', function(e) {
      if (window.innerWidth <= 540) { e.preventDefault(); d.classList.toggle('open'); }
    });
  });
  const burger = document.getElementById('navBurger');
  const navLinks = document.getElementById('navLinks');
  if (burger && navLinks) {
    burger.addEventListener('click', () => navLinks.classList.toggle('open'));
  }

  const fy = document.getElementById('footerYear');
  if (fy) fy.textContent = String(new Date().getFullYear());

  (function() {
    const GA_ID = 'G-PK9JHLK9YF';
    const banner = document.getElementById('cookieBanner');
    const btnAccept = document.getElementById('cookieAccept');
    const btnRefuse = document.getElementById('cookieRefuse');
    if (!banner) return;
    const consent = localStorage.getItem('lcp-consent');
    if (!consent) setTimeout(() => banner.classList.add('cookie-visible'), 800);
    function hideBanner() { banner.classList.add('cookie-hide'); banner.classList.remove('cookie-visible'); }
    if (btnAccept) {
      btnAccept.addEventListener('click', () => {
        localStorage.setItem('lcp-consent', 'accepted');
        hideBanner();
        var s = document.createElement('script');
        s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', GA_ID);
      });
    }
    if (btnRefuse) {
      btnRefuse.addEventListener('click', () => {
        localStorage.setItem('lcp-consent', 'refused');
        window['ga-disable-' + GA_ID] = true;
        hideBanner();
      });
    }
  })();
</script>

<button id="backToTop" class="back-to-top" aria-label="Retour en haut">↑</button>

</body>
</html>
